<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#6C63FF" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="VoiceAI" />
  <title>Voice → Action</title>
  <link rel="manifest" href="./manifest.json" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    
    :root {
      --bg: #0F0F14;
      --surface: #1a1a2e;
      --surface2: #16213e;
      --border: #ffffff12;
      --text: #E8E8F0;
      --muted: #888;
      --dim: #555;
      --accent: #6C63FF;
      --accent2: #a855f7;
    }

    html, body {
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif;
      overflow-x: hidden;
    }

    /* HEADER */
    .header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(15,15,20,0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 14px 16px;
      display: flex; align-items: center; gap: 12px;
    }
    .header-icon {
      width: 38px; height: 38px; border-radius: 10px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    }
    .header-title { font-size: 17px; font-weight: 700; letter-spacing: -0.3px; }
    .header-sub { font-size: 11px; color: var(--muted); margin-top: 1px; }

    /* MAIN SCROLL */
    .main { padding: 16px 14px 100px; max-width: 500px; margin: 0 auto; }

    /* TEXTAREA CARD */
    .input-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
      margin-bottom: 14px;
      transition: border-color 0.2s;
    }
    .input-card:focus-within { border-color: #6C63FF55; }

    textarea {
      width: 100%; min-height: 130px;
      background: transparent; border: none; outline: none;
      color: var(--text); font-size: 15px; line-height: 1.65;
      padding: 16px 16px 10px;
      resize: none; font-family: inherit;
    }
    textarea::placeholder { color: #444; }

    .input-footer {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 16px 14px;
    }
    .char-count { font-size: 11px; color: var(--dim); }

    /* MIC BUTTON */
    .mic-btn {
      width: 36px; height: 36px; border-radius: 50%;
      background: #ffffff0a; border: 1px solid var(--border);
      color: var(--muted); font-size: 16px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.2s; flex-shrink: 0;
    }
    .mic-btn.recording {
      background: #EF444420; border-color: #EF4444;
      animation: micPulse 1s infinite;
    }
    @keyframes micPulse {
      0%,100% { box-shadow: 0 0 0 0 #EF444430; }
      50% { box-shadow: 0 0 0 8px #EF444400; }
    }

    /* CLASSIFY BTN */
    .classify-btn {
      flex: 1; margin-left: 10px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff; border: none; border-radius: 12px;
      padding: 11px 20px; font-size: 14px; font-weight: 600;
      cursor: pointer; transition: opacity 0.2s;
    }
    .classify-btn:disabled { background: #1e1e2e; color: var(--dim); cursor: default; }
    .classify-btn:not(:disabled):active { opacity: 0.85; }

    /* LOADING */
    .loading {
      text-align: center; padding: 36px 0;
    }
    .loading-emoji {
      font-size: 36px;
      display: inline-block;
      animation: bounce 0.8s infinite alternate;
    }
    @keyframes bounce { from { transform: translateY(0); } to { transform: translateY(-8px); } }
    .loading p { margin-top: 10px; font-size: 14px; color: var(--muted); }

    /* RESULT CATEGORY CARD */
    .result-card {
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 12px;
      border: 1px solid;
    }
    .cat-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
    .cat-label { font-size: 20px; font-weight: 700; }
    .badges { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
    .badge {
      font-size: 11px; font-weight: 600;
      padding: 3px 10px; border-radius: 20px;
    }
    .summary { font-size: 14px; color: #ccc; line-height: 1.65; margin-bottom: 10px; }
    .insight { font-size: 13px; font-style: italic; line-height: 1.55; }

    /* ACTION STEPS */
    .action-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 18px; padding: 16px; margin-bottom: 14px;
    }
    .action-title {
      font-size: 11px; color: var(--muted);
      text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px;
    }
    .action-item {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid #ffffff06;
      cursor: pointer;
    }
    .action-item:last-child { border-bottom: none; }
    .checkbox {
      width: 22px; height: 22px; border-radius: 7px;
      border: 2px solid #333; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      margin-top: 1px; transition: all 0.15s; font-size: 12px;
    }
    .action-text {
      font-size: 14px; line-height: 1.55; transition: all 0.15s; flex: 1;
    }

    /* HISTORY */
    .section-label {
      font-size: 11px; color: var(--dim);
      text-transform: uppercase; letter-spacing: 0.8px;
      margin-bottom: 10px; margin-top: 6px;
    }
    .history-item {
      background: var(--surface); border-radius: 14px;
      padding: 12px 14px; margin-bottom: 8px;
      border: 1px solid var(--border); cursor: pointer;
      transition: border-color 0.15s;
    }
    .history-item:active { opacity: 0.8; }
    .history-top { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .history-cat { font-size: 13px; font-weight: 600; }
    .history-conf { font-size: 11px; color: var(--dim); }
    .history-text { font-size: 12px; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* EMPTY STATE */
    .empty {
      text-align: center; padding: 40px 20px; color: #444;
    }
    .empty-icon { font-size: 52px; margin-bottom: 14px; }
    .empty p { font-size: 15px; line-height: 1.65; color: #555; }
    .cat-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; }
    .cat-pill { font-size: 12px; padding: 5px 12px; border-radius: 20px; border: 1px solid; }

    /* TOAST */
    .toast {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
      background: #1e1e2e; border: 1px solid var(--border);
      color: var(--text); font-size: 13px; padding: 10px 20px;
      border-radius: 30px; z-index: 999;
      animation: toastIn 0.3s ease;
      white-space: nowrap;
    }
    @keyframes toastIn { from { opacity:0; transform: translateX(-50%) translateY(10px); } to { opacity:1; transform: translateX(-50%) translateY(0); } }

    /* ERROR */
    .error-box {
      background: #EF444415; border: 1px solid #EF444440;
      border-radius: 12px; padding: 12px 16px;
      color: #EF4444; font-size: 14px; margin-bottom: 14px;
    }

    /* Safe area for notch phones */
    .header { padding-top: max(14px, env(safe-area-inset-top)); }
  </style>
</head>
<body>

<div class="header">
  <div class="header-icon">🎙</div>
  <div>
    <div class="header-title">Voice → Action</div>
    <div class="header-sub">Classify karo, action lo</div>
  </div>
</div>

<div class="main" id="main">
  <!-- Input Card -->
  <div class="input-card">
    <textarea id="noteInput" placeholder="Apni voice note yahan type karo ya mic se bolo...&#10;&#10;Jaise: 'YouTube Shorts pe daily content dalna chahta hoon trending topics pe...'"></textarea>
    <div class="input-footer">
      <span class="char-count" id="charCount">0 chars</span>
      <button class="mic-btn" id="micBtn" title="Voice input">🎙</button>
      <button class="classify-btn" id="classifyBtn" disabled onclick="classify()">✨ Classify Karo</button>
    </div>
  </div>

  <div id="errorBox" class="error-box" style="display:none"></div>
  <div id="loadingBox" class="loading" style="display:none">
    <div class="loading-emoji">🤔</div>
    <p>AI soch raha hai...</p>
  </div>
  <div id="resultBox"></div>
  <div id="historyBox"></div>
  <div id="emptyState" class="empty">
    <div class="empty-icon">🎙️</div>
    <p>Koi bhi thought type karo ya bolo —<br>Content idea, business plan, life moment, kuch bhi</p>
    <div class="cat-pills" id="catPills"></div>
  </div>
</div>

<script>
const CATEGORIES = {
  CONTENT_IDEA: {
    label: "💡 Content Idea", color: "#6C63FF", bg: "#6C63FF12", border: "#6C63FF35",
    actions: ["Platform choose karo (YouTube/Instagram/Blog)", "Hook line likho — pehli 3 seconds", "Script outline banao", "Publish date calendar mein set karo", "Thumbnail/Visual plan karo"]
  },
  BUSINESS_DECISION: {
    label: "💼 Business Decision", color: "#F59E0B", bg: "#F59E0B12", border: "#F59E0B35",
    actions: ["Pros & Cons list banao", "Risk level assess karo (Low/Med/High)", "Market research ya data dhundo", "Mentor/advisor se 1 call karo", "72-hour rule — kal fresh mind se dekho"]
  },
  LIFE_MOMENT: {
    label: "🌟 Life Changing Moment", color: "#10B981", bg: "#10B98112", border: "#10B98135",
    actions: ["Journal mein likho — emotions capture karo", "Iska long-term impact socho", "Kisi trusted insaan se share karo", "Ek concrete next step aaj decide karo", "Vision board ya reminder set karo"]
  },
  TASK_TODO: {
    label: "✅ Task / To-Do", color: "#3B82F6", bg: "#3B82F612", border: "#3B82F635",
    actions: ["Priority set karo: Urgent/Important?", "Time estimate lagao (15min / 1hr / 1day)", "Calendar ya task app mein add karo", "Sub-tasks list banao", "Deadline fix karo — vague nahi chalega"]
  },
  PROBLEM: {
    label: "🔥 Problem / Blocker", color: "#EF4444", bg: "#EF444412", border: "#EF444435",
    actions: ["Root cause identify karo (5 Whys method)", "Kya ye tumhare control mein hai?", "3 possible solutions brainstorm karo", "Help maango — akele mat jhelo", "Temporary fix vs permanent fix decide karo"]
  },
  RANDOM_THOUGHT: {
    label: "🧠 Random Thought", color: "#8B5CF6", bg: "#8B5CF612", border: "#8B5CF635",
    actions: ["Second Brain app mein save karo (Notion/Obsidian)", "Ek line mein summarize karo", "Kisi existing project se connect hota hai?", "1 week baad revisit reminder set karo", "Elaborate karo — 5 lines likho"]
  }
};

const URGENCY_COLORS = { HIGH: "#EF4444", MEDIUM: "#F59E0B", LOW: "#10B981" };

let history = JSON.parse(localStorage.getItem('voa_history') || '[]');
let checkedActions = {};
let currentResult = null;
let recognition = null;
let isRecording = false;

// Init
document.getElementById('noteInput').addEventListener('input', function() {
  document.getElementById('charCount').textContent = this.value.length + ' chars';
  document.getElementById('classifyBtn').disabled = !this.value.trim();
});

// Render empty state pills
const pillsEl = document.getElementById('catPills');
Object.values(CATEGORIES).forEach(c => {
  const pill = document.createElement('span');
  pill.className = 'cat-pill';
  pill.textContent = c.label;
  pill.style.cssText = `color:${c.color};background:${c.bg};border-color:${c.border}`;
  pillsEl.appendChild(pill);
});

// Speech recognition
const micBtn = document.getElementById('micBtn');
if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  recognition = new SR();
  recognition.continuous = true;
  recognition.interimResults = true;
  recognition.lang = 'hi-IN';

  recognition.onresult = (e) => {
    let transcript = '';
    for (let i = 0; i < e.results.length; i++) {
      transcript += e.results[i][0].transcript;
    }
    document.getElementById('noteInput').value = transcript;
    document.getElementById('charCount').textContent = transcript.length + ' chars';
    document.getElementById('classifyBtn').disabled = !transcript.trim();
  };

  recognition.onend = () => {
    isRecording = false;
    micBtn.classList.remove('recording');
    micBtn.textContent = '🎙';
  };

  micBtn.addEventListener('click', () => {
    if (isRecording) {
      recognition.stop();
    } else {
      recognition.start();
      isRecording = true;
      micBtn.classList.add('recording');
      micBtn.textContent = '⏹';
      showToast('Bol raha hoon... 🎙');
    }
  });
} else {
  micBtn.title = 'Is browser mein mic support nahi';
  micBtn.style.opacity = '0.4';
}

async function classify() {
  const text = document.getElementById('noteInput').value.trim();
  if (!text) return;

  checkedActions = {};
  showLoading(true);
  showError('');
  document.getElementById('resultBox').innerHTML = '';
  document.getElementById('emptyState').style.display = 'none';

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{
          role: 'user',
          content: `You are a smart personal assistant. Classify this voice note into EXACTLY ONE category and provide analysis in Hinglish (Hindi + English mix).

Voice Note: "${text}"

Categories:
- CONTENT_IDEA: YouTube video, reel, blog, podcast idea
- BUSINESS_DECISION: business/career decision, investment, partnership
- LIFE_MOMENT: emotional, personal growth, relationship, spiritual realization
- TASK_TODO: specific kaam, reminder, errand
- PROBLEM: challenge, blocker, complaint, stress
- RANDOM_THOUGHT: philosophical, creative, misc thought

Respond ONLY in this exact JSON (no markdown, no backticks):
{"category":"CATEGORY_NAME","confidence":85,"summary":"2-3 line Hinglish mein is note ka essence","insight":"1 powerful observation ya pattern","urgency":"HIGH/MEDIUM/LOW"}`
        }]
      })
    });

    const data = await response.json();
    let raw = data.content?.[0]?.text || '{}';
    raw = raw.replace(/```json|```/g, '').trim();
    const result = JSON.parse(raw);
    result.text = text;
    currentResult = result;

    // Save to history
    history = [result, ...history.slice(0, 9)];
    localStorage.setItem('voa_history', JSON.stringify(history));

    renderResult(result);
    renderHistory();
  } catch(e) {
    showError('Kuch gadbad hui. Internet check karo ya dobara try karo. 🙏');
    document.getElementById('emptyState').style.display = 'block';
  }

  showLoading(false);
}

function renderResult(result) {
  const cat = CATEGORIES[result.category] || CATEGORIES.RANDOM_THOUGHT;
  const urgColor = URGENCY_COLORS[result.urgency] || '#888';

  let actionsHTML = cat.actions.map((action, i) => `
    <div class="action-item" onclick="toggleAction(${i})" id="action-${i}">
      <div class="checkbox" id="cb-${i}" style="border-color:#333">&nbsp;</div>
      <div class="action-text" id="at-${i}" style="color:#ddd">${action}</div>
    </div>
  `).join('');

  document.getElementById('resultBox').innerHTML = `
    <div class="result-card" style="background:${cat.bg};border-color:${cat.border}">
      <div class="cat-label" style="color:${cat.color}">${cat.label}</div>
      <div class="badges">
        <span class="badge" style="background:${cat.color}25;color:${cat.color}">${result.confidence}% confident</span>
        <span class="badge" style="background:${urgColor}20;color:${urgColor}">${result.urgency} urgency</span>
      </div>
      <div style="margin-top:14px">
        <div class="summary">${result.summary}</div>
        <div class="insight" style="color:${cat.color}">💬 ${result.insight}</div>
      </div>
    </div>
    <div class="action-card">
      <div class="action-title">Action Plan</div>
      ${actionsHTML}
    </div>
  `;
  checkedActions = {};
}

function toggleAction(i) {
  checkedActions[i] = !checkedActions[i];
  const cat = CATEGORIES[currentResult?.category] || CATEGORIES.RANDOM_THOUGHT;
  const cb = document.getElementById('cb-' + i);
  const at = document.getElementById('at-' + i);
  if (checkedActions[i]) {
    cb.style.background = cat.color;
    cb.style.borderColor = cat.color;
    cb.textContent = '✓';
    at.style.color = '#444';
    at.style.textDecoration = 'line-through';
  } else {
    cb.style.background = 'transparent';
    cb.style.borderColor = '#333';
    cb.textContent = ' ';
    at.style.color = '#ddd';
    at.style.textDecoration = 'none';
  }
}

function renderHistory() {
  const box = document.getElementById('historyBox');
  if (history.length <= 1) { box.innerHTML = ''; return; }

  const items = history.slice(1).map(item => {
    const c = CATEGORIES[item.category] || CATEGORIES.RANDOM_THOUGHT;
    return `
      <div class="history-item" onclick="loadHistory('${encodeURIComponent(JSON.stringify(item))}')" style="border-color:${c.border}">
        <div class="history-top">
          <span class="history-cat" style="color:${c.color}">${c.label}</span>
          <span class="history-conf">${item.confidence}%</span>
        </div>
        <div class="history-text">${item.text}</div>
      </div>
    `;
  }).join('');

  box.innerHTML = `<div class="section-label">Recent Notes</div>${items}`;
}

function loadHistory(encoded) {
  const item = JSON.parse(decodeURIComponent(encoded));
  document.getElementById('noteInput').value = item.text;
  document.getElementById('charCount').textContent = item.text.length + ' chars';
  document.getElementById('classifyBtn').disabled = false;
  currentResult = item;
  renderResult(item);
  document.getElementById('emptyState').style.display = 'none';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function showLoading(show) {
  document.getElementById('loadingBox').style.display = show ? 'block' : 'none';
  document.getElementById('classifyBtn').disabled = show;
}

function showError(msg) {
  const box = document.getElementById('errorBox');
  box.style.display = msg ? 'block' : 'none';
  box.textContent = msg;
}

function showToast(msg) {
  const old = document.querySelector('.toast');
  if (old) old.remove();
  const t = document.createElement('div');
  t.className = 'toast';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2500);
}

// Load history on start
if (history.length > 0) {
  document.getElementById('emptyState').style.display = history.length === 0 ? 'block' : 'none';
  renderHistory();
}

// Service Worker
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js').catch(() => {});
}

// Enter key shortcut
document.getElementById('noteInput').addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'Enter') classify();
});
</script>
</body>
</html>
